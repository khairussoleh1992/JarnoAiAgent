<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0E17"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="JARNO CORE MODEL"
        android:textColor="#00E5FF"
        android:textSize="12sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/btnBrowseModel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="8dp"
        android:backgroundTint="#121826"
        android:text="PILIH FILE MODEL (.bin)"
        android:textColor="#00E5FF"
        android:textSize="12sp"
        android:textStyle="bold" />

    <Spinner
        android:id="@+id/spinnerModels"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:backgroundTint="#00E5FF" />

    <TextView
        android:id="@+id/txtResponse"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginBottom="16dp"
        android:background="#121826"
        android:padding="12dp"
        android:text="Jarno System Initializing..."
        android:textColor="#E0F7FA"
        android:textSize="14sp" />

    <EditText
        android:id="@+id/inputPrompt"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:backgroundTint="#00E5FF"
        android:hint="Perintah untuk Jarno..."
        android:textColor="#FFFFFF"
        android:textColorHint="#546E7A" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnMic"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginRight="4dp"
            android:backgroundTint="#00838F"
            android:text="BICARA 🎤"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnSend"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginLeft="4dp"
            android:backgroundTint="#00E5FF"
            android:text="KIRIM"
            android:textColor="#0A0E17"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
